apiVersion: batch/v1
kind: Job
metadata:
  name: "psql-{{ postgres_config_name }}-config-{{ lookup('community.general.random_string', min_lower=10, length=10)}}"
  namespace: "{{ postgres_config_namespace }}"
spec:
  template:
    spec:
      volumes:
      - name: config-script
        configMap:
          name: "psql-{{ postgres_config_name }}-config-script"
          # 711 in decimal is 457
          defaultMode: 457
      containers:
      - name:  psql-config
        image: ghcr.io/dbildungsplattform/cron-tools:{{ cron_tools_image_tag }}
        command:
          - /bin/bash
          - -c
        args:
          - /scripts/config-script
        resources:
          limits:
            cpu: 1000m
            memory: 2Gi
          requests:
            cpu: 100m
            memory: 1Gi
        volumeMounts:
        - name: config-script
          mountPath: /scripts/
        envFrom:
          - secretRef:
              name: "psql-{{ postgres_config_name }}-config"
{% if existing_secret is defined %}
        env:
{% if postgres_config_pass_key is defined %}
          - name: "PGPASSWORD"
            valueFrom:
              secretKeyRef:
                name: "{{ existing_secret }}"
                key: "{{ postgres_config_pass_key }}"
{% endif %}
{% if postgres_config_user_key is defined %}
          - name: "PGUSER"
            valueFrom:
              secretKeyRef:
                name: "{{ existing_secret }}"
                key: "{{ postgres_config_user_key }}"
{% endif %}
{% endif %}
      restartPolicy: Never
backoffLimit: 4
